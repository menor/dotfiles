# Ghostty config
#
# Reference:  ghostty +show-config --default --docs
# Validate:   ghostty +validate-config
# Reload:     cmd+shift+,
#
# Rationale for every line lives in ./README.md.
# tmux owns tabs, splits, scrollback, the window title, and process lifetime.
# This file deliberately stays out of its way.

#--------------------------------------------------------------------
# Theme
#--------------------------------------------------------------------

# Selenized: Solarized rebuilt with per-background accents.
# Follows the macOS system appearance. See README §2.2 and §3.1.
# Swap to "Selenized Black" for a pure #000000 ground.
theme = light:Selenized Light,dark:Selenized Dark

# Enforced at draw time, so it also corrects programs that hardcode truecolor
# and ignore the palette. Selenized Light's own dim grey (#909995) sits at
# 2.64:1 on the cream background; 3 lifts it without flattening the accents
# that already clear it. See README §2.2.
minimum-contrast = 3

#--------------------------------------------------------------------
# Font
#--------------------------------------------------------------------

# Ghostty bundles JetBrains Mono, but only Regular and Bold. Installing the
# cask adds the designed Medium (weight 500) face, which reads heavier than
# Regular without synthesising anything. Requires: brew bundle (see Brewfile).
# Run `ghostty +list-fonts` to see what else is available.
font-family = "JetBrains Mono"
font-style = "Medium"
font-size = 14

# font-thicken is macOS stem darkening: it fattens the stroke of whatever face
# is loaded. A real Medium face is the better answer, so this stays off.
# font-thicken = true
# font-thicken-strength = 128

# Uncomment to disable programming ligatures.
# font-feature = -calt
# font-feature = -liga
# font-feature = -dlig

#--------------------------------------------------------------------
# Appearance
#--------------------------------------------------------------------

window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
mouse-hide-while-typing = true

#--------------------------------------------------------------------
# Window chrome
#--------------------------------------------------------------------

# tmux provides tabs. A second tab bar is duplicate state.
window-show-tab-bar = never

# `hidden` reclaims the titlebar height entirely. `native` keeps the standard bar.
macos-titlebar-style = tabs

# Sends ESC+key so Meta bindings reach tmux, zsh and nvim.
# Cost: no option-key characters. Use `left` to keep the right option key.
macos-option-as-alt = true

# tmux-resurrect and tmux-continuum already restore sessions.
# Two restore mechanisms produce duplicate windows.
window-save-state = never

# Safe because the tmux server is detached: closing a window detaches the
# client, it does not kill the session. Work started outside tmux dies here.
confirm-close-surface = false
quit-after-last-window-closed = true

#--------------------------------------------------------------------
# Shell integration
#--------------------------------------------------------------------

shell-integration = zsh

# no-title  : tmux sets the title; without this they fight.
# sudo      : preserves TERMINFO across sudo.
# ssh-*     : installs xterm-ghostty terminfo on remote hosts, falling back to
#             xterm-256color, so colors survive ssh. Harmless if unused.
shell-integration-features = cursor,no-title,sudo,ssh-env,ssh-terminfo,path

#--------------------------------------------------------------------
# Agent signals
#--------------------------------------------------------------------

# Bounce the dock icon, flag the title, outline the surface.
# Needs `set -g allow-passthrough on` in tmux.conf to fire from inside a pane.
bell-features = attention,title,border

# notify-on-command-finish needs OSC 133, which tmux consumes rather than
# forwards. Only useful outside tmux; enable if that matches how you work.
# notify-on-command-finish = unfocused
# notify-on-command-finish-after = 30s
# notify-on-command-finish-action = no-bell,notify

#--------------------------------------------------------------------
# Keybindings
#--------------------------------------------------------------------

# ctrl+h/j/k/l and ctrl+\ are intentionally unbound here.
# vim-tmux-navigator owns them.

# Lock the surface so a stray keystroke cannot land in a running agent.
keybind = cmd+shift+r=toggle_readonly


# Sourced from zsh/zshrc.

alias la='ls -a'

# Neovim
alias n='nvim'

# Tmux
alias tl='tmux ls'
alias ta='tmux attach -t'
alias tn='tmux new-session -s'
alias tk='tmux kill-session -t'

alias pkg='cat package.json'

# Homebrew's sqlite, not the older system copy
alias sqlite='$(brew --prefix)/opt/sqlite/bin/sqlite3'

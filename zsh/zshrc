# Interactive shell config. Symlinked to ~/.zshrc by setup.sh.
#
# No plugin manager. The two plugins live as git submodules under
# zsh/plugins/ and are sourced directly, so a fresh machine needs
# `git submodule update --init` and nothing else.

# Path
# -----------------------------------------------------------------------------
export DOTDIR=$HOME/.dotfiles
export XDG_CONFIG_HOME=$HOME/.config

# Scripts in this repo. First on PATH so they win over anything installed.
export PATH=$DOTDIR/bin:$PATH

# Where user-level installers drop binaries. Claude Code lives here.
# Prepended, so a tool installed here beats an older copy in /usr/local/bin.
export PATH=$HOME/.local/bin:$PATH

export EDITOR=nvim
export VISUAL=nvim

# Options
# -----------------------------------------------------------------------------
setopt NO_CASE_GLOB   # case insensitive globbing
setopt AUTO_CD        # bare directory name means cd

# Correct mistyped command names. Deliberately not CORRECT_ALL, which also
# second-guesses arguments and forces `nocorrect` aliases on anything taking a
# path or a pattern like ./...
setopt CORRECT
SPROMPT="Correct %F{red}%R%f to %F{green}%r%f [nyae]?"

# Completion
# -----------------------------------------------------------------------------
autoload -Uz compinit
# Rebuild the dump once a day. -C reuses it and skips the security audit, which
# is the slow part of compinit.
if [[ -n ~/.zcompdump(#qN.mh-24) ]]; then
  compinit -C
else
  compinit
fi

# Case insensitive path completion
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}'

# History
# -----------------------------------------------------------------------------
HISTFILE=$HOME/.tmp/zsh/.zsh_history
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}

HISTSIZE=10000   # in memory
SAVEHIST=50000   # on disk

setopt HIST_IGNORE_DUPS     # drop repeats of the previous command
setopt HIST_REDUCE_BLANKS   # strip surplus whitespace
setopt SHARE_HISTORY        # live sync across running shells
setopt APPEND_HISTORY       # add, never truncate
setopt INC_APPEND_HISTORY   # write as typed, not at exit
setopt HIST_VERIFY          # expand !! for review instead of running it
setopt EXTENDED_HISTORY     # record timestamps

# EDITOR=nvim would otherwise switch the line editor to vi mode, which breaks
# ctrl+R and the rest of the emacs bindings.
bindkey -e

# Prompt
# -----------------------------------------------------------------------------
# pure bundles its own async.zsh, so this is the only dependency.
fpath+=($DOTDIR/zsh/plugins/pure)
autoload -Uz promptinit && promptinit
prompt pure

# Plugins
# -----------------------------------------------------------------------------
source $DOTDIR/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# Tools
# -----------------------------------------------------------------------------
# z: jump to frequently used directories
[[ -f /usr/local/etc/profile.d/z.sh ]] && source /usr/local/etc/profile.d/z.sh

# fnm: node version manager. Left as the plain eval for now; the lazy-loading
# version from the work machine can come later if startup time becomes a
# problem.
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"

# Claude Code
# -----------------------------------------------------------------------------
# Force the classic renderer. The fullscreen renderer draws on the alternate
# screen, like vim, so the conversation never enters tmux's scrollback and
# `prefix + [` has nothing to page through. Classic keeps it all in the normal
# buffer, where ctrl+b and ctrl+f work and the copy bindings in
# tmux/tmux.conf:155-174 can select it.
#
# Also hands the mouse back to tmux: the fullscreen renderer captures it, which
# is what disables the DoubleClick1Pane and TripleClick1Pane bindings.
#
# Costs some redraw flicker, since tmux 3.6 and earlier have no synchronised
# output. Overrides the `tui` key in ~/.claude/settings.json, which is per
# machine and therefore not tracked here.
export CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1

# Aliases
# -----------------------------------------------------------------------------
source $DOTDIR/aliases
